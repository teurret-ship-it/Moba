{
  "name": "moba-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Faza 0 — prototyp grywalności areny sesyjnej (web-first, Three.js)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
